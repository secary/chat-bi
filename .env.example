# Business/app/admin database. Docker demos expose this MySQL on host port 3307.
CHATBI_DB_HOST=127.0.0.1
CHATBI_DB_PORT=3307
CHATBI_DB_NAME=chatbi_demo
CHATBI_DB_USER=demo_user
CHATBI_DB_PASSWORD=demo_pass

# LLM provider for LiteLLM. This placeholder targets Ollama running on the host.
# For host-run backend, API_BASE can be http://localhost:11434.
# LLM_MODEL=ollama/qwen2.5:7b
# API_BASE=http://host.docker.internal:11434
# OPENAI_API_KEY=

# Max LLM rounds per user message (each round may execute one Skill).
CHATBI_AGENT_MAX_STEPS=30

# JWT for authenticated API. Use a strong random secret outside local demo.
CHATBI_JWT_SECRET=change-me-in-production
CHATBI_JWT_EXP_HOURS=168

# Seed users into app_user on backend startup. Use root as the super administrator.
# Format: username:password:role;username2:password2:role2
# Role must be admin or user. Existing users keep passwords unless reset is enabled.
CHATBI_SEED_USERS=root:chatbi:root;admin:admin123:admin
# CHATBI_SEED_USERS_RESET_PASSWORD=0

# Optional Docker image/build mirror overrides for restricted networks.
MYSQL_IMAGE=m.daocloud.io/docker.io/library/mysql:8.0
PYTHON_IMAGE=m.daocloud.io/docker.io/library/python:3.11-slim
NODE_IMAGE=m.daocloud.io/docker.io/library/node:22-bookworm-slim
DEBIAN_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian
DEBIAN_SECURITY_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian-security
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
NPM_REGISTRY=https://registry.npmmirror.com
