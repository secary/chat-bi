# Main demo database.
CHATBI_DB_HOST=127.0.0.1
CHATBI_DB_PORT=3307
CHATBI_DB_NAME=chatbi_demo
CHATBI_DB_USER=demo_user
CHATBI_DB_PASSWORD=demo_pass

# Trace/log database.
CHATBI_LOG_DB_HOST=127.0.0.1
CHATBI_LOG_DB_PORT=33067
CHATBI_LOG_DB_NAME=chatbi_local_logs
CHATBI_LOG_DB_USER=demo_user
CHATBI_LOG_DB_PASSWORD=demo_pass

# Agent runtime.
CHATBI_AGENT_REACT=1
CHATBI_AGENT_MAX_STEPS=8

# Auth and seed admin. Use strong secrets/passwords outside local demo.
CHATBI_JWT_SECRET=change-me-in-production
CHATBI_JWT_EXP_HOURS=168
CHATBI_DEFAULT_ADMIN_USERNAME=admin
CHATBI_DEFAULT_ADMIN_PASSWORD=admin123

# Optional auth/memory overrides.
# CHATBI_DEFAULT_ADMIN_RESET_PASSWORD=0
# CHATBI_AUTH_ENABLED=1
# CHATBI_AUTH_DEV_USER_ID=1
# CHATBI_MEMORY_DISABLED=0
